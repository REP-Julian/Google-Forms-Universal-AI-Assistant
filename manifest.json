{
  "manifest_version": 3,
  "name": "Google Forms Universal AI Assistant HUD",
  "version": "1.4.0",
  "description": "Full Google Forms AI Solver Patch 1.4.0 with Anti-Proctor Visibility Shield, Face-Down Panic Screen Wipe, IndexedDB Local Answer Cache, Countdown Timer Watchdog, and Weak-Signal Carrier Resilience.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://docs.google.com/*",
    "https://forms.google.com/*",
    "https://forms.gle/*",
    "https://anymodel.org/*",
    "https://*.google.com/*",
    "https://www.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/forms/*",
        "*://forms.google.com/*",
        "*://forms.gle/*"
      ],
      "js": [
        "google_form.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "files/*"
      ],
      "matches": [
        "*://docs.google.com/*",
        "*://forms.google.com/*",
        "*://forms.gle/*"
      ]
    }
  ]
}
